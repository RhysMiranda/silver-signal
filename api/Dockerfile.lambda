# Lambda container image for the API. Build from the repo root:
#   docker build --platform linux/amd64 --provenance=false -f api/Dockerfile.lambda -t silver-signal-api-lambda .
FROM public.ecr.aws/lambda/python:3.11
COPY api/requirements.txt api/requirements.txt
RUN pip install --no-cache-dir -r api/requirements.txt mangum>=0.17
COPY silver_signal silver_signal
COPY api api
CMD ["api.lambda_handler.handler"]
